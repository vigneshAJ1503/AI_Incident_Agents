# Copy to .env and fill in. NEVER commit .env.
# Variables are added PR by PR; each is documented where it is introduced.

# --- Environment selection -------------------------------------------------
# Which config/environments/<name>.yaml to load (PR-002)
AIOPS_ENV=local

# --- LLM provider (PR-004) --------------------------------------------------
# anthropic | openai_compat
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For openai_compat: OpenAI, Groq (https://api.groq.com/openai/v1) or Ollama (http://localhost:11434/v1)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Jira (PR-012) ------------------------------------------------------------
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
