# Copy to .env and fill in. NEVER commit .env.
# Variables are added PR by PR; each is documented where it is introduced.

# --- Environment selection -------------------------------------------------
# Which company profile to load: profiles/<name>/ (PR-P1, docs/portability.md).
# AIOPS_ENV still works as a deprecated alias. Profiles kept outside this repo:
# AIOPS_PROFILES_DIR=/path/to/private/profiles
AIOPS_PROFILE=local

# --- LLM provider (PR-004) — zero cost: docs/setup/zero-cost.md -------------
# openai_compat works with hosted Groq (free) or Gemini (free). No local models.
LLM_PROVIDER=openai_compat
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
# Optional fallback key (same provider), used when the first one is rate-limited
OPENAI_COMPAT_API_KEY_2=
# Model per role; pick from your provider's model list (must support tool calling)
LLM_MODEL_FAST=
LLM_MODEL_AGENT=
LLM_MODEL_RCA=
# Enterprise LLM platforms (PR-P4b, docs/setup/llm-providers.md): used by a profile whose
# llm block selects them (profiles/_template/profile.yaml). Names only, never commit values.
# ANTHROPIC_API_KEY=                 # provider: anthropic (SECRET)
# ANTHROPIC_BASE_URL=                # optional gateway
# AWS_REGION=                        # provider: bedrock; credentials from the AWS chain
# AWS_PROFILE=                       #   (SSO / IRSA / instance role), never in YAML
# BEDROCK_ENDPOINT_URL=              # optional VPC endpoint
# AZURE_OPENAI_ENDPOINT=             # provider: azure_openai
# AZURE_OPENAI_API_KEY=              # SECRET
# AZURE_OPENAI_API_VERSION=
# Optional: reasoning effort for reasoning models (low|medium|high), e.g. low for openai/gpt-oss on Groq
LLM_REASONING_EFFORT=

# --- Local infrastructure (PR-007) -------------------------------------------
# Pinned image versions (never :latest)
ES_VERSION=8.19.4
KIBANA_VERSION=8.19.4
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7.4-alpine
# Host ports (bound to 127.0.0.1). Postgres/Redis use non-default ports to avoid clashing
# with locally installed services.
# Lean memory budget (docs/setup/zero-cost.md): 512 MB heap is plenty for the sample data
ES_HEAP=512m
ES_MEM_LIMIT=1280m
ES_PORT=9200
KIBANA_PORT=5601
POSTGRES_PORT=15432
REDIS_PORT=16379
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops-local-only
POSTGRES_DB=aiops
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601

# --- MCP servers (PR-008) ----------------------------------------------------
LOGS_MCP_PORT=8101
LOGS_MCP_URL=http://localhost:8101/mcp
# Server-side guardrails for elasticsearch-mcp
LOGS_ALLOWED_INDEX_PATTERNS=payment-prod-*,order-prod-*,user-prod-*,inventory-prod-*,payment-staging-*,order-staging-*,user-staging-*,inventory-staging-*,logs-k8s-*
LOGS_MAX_TIME_RANGE_HOURS=48
LOGS_MAX_RESULTS=1000
LOGS_QUERY_TIMEOUT_S=30

# --- Code agent / git-mcp (PR-026, PR-027) -------------------------------------
# git-mcp serves .data/sample-repo (make seed-repo S=S1), mounted read-only
CODE_MCP_PORT=8107
CODE_MCP_URL=http://localhost:8107/mcp
# CODE_SAMPLE_REPO_DIR=../../.data/sample-repo   # relative to deploy/compose/
# Server-side guardrails for git-mcp
CODE_MAX_COMMITS=200
CODE_MAX_DIFF_CHARS=40000
CODE_MAX_RANGE_DAYS=90
# Optional commit deep link for evidence, e.g. https://github.com/acme/{repo}/commit/{sha}
CODE_UI_LINK_TEMPLATE=

# --- Alerts (PR-023) -----------------------------------------------------------
# Alertmanager (in docker-compose.infra.yml). Real alerts come from Prometheus (PR-020);
# `make seed-alerts S=S1` posts synthetic ones for fixed-time evals. Keep the version in sync
# with the Makefile.
ALERTMANAGER_VERSION=v0.34.1
ALERTMANAGER_PORT=9093
ALERTMANAGER_URL=http://localhost:9093
# alertmanager-mcp (PR-024, in docker-compose.mcp.yml) and its server-side guardrails
ALERTS_MCP_PORT=8105
ALERTS_MCP_URL=http://localhost:8105/mcp
ALERTS_MAX_RESULTS=200
ALERTS_MAX_TIME_RANGE_HOURS=168
ALERTS_QUERY_TIMEOUT_S=15

# --- Kubernetes (PR-018) -------------------------------------------------------
# kubernetes-mcp reads the cluster as the read-only aiops-reader ServiceAccount
# (deploy/k8s/rbac). `make k8s-reader-kubeconfig` writes .data/k8s/aiops-reader.kubeconfig
# with a short-lived token (never committed); rerun it when the token expires.
K8S_MCP_PORT=8106
K8S_MCP_URL=http://localhost:8106/mcp
K8S_READER_TOKEN_DURATION=24h
# The API server as reached from containers on the aiops network (Minikube node IP)
K8S_READER_SERVER=https://172.21.0.100:8443
# Server-side guardrails for kubernetes-mcp
K8S_ALLOWED_NAMESPACES=prod
K8S_MAX_RESULTS=200
K8S_MAX_LOG_LINES=300
K8S_MAX_SINCE_HOURS=48
K8S_QUERY_TIMEOUT_S=15

# --- Metrics (PR-020) -------------------------------------------------------------
# Prometheus (always on, in docker-compose.infra.yml) scrapes the sample services and
# kube-state-metrics in Minikube and evaluates the alert rules. Keep the version in sync with
# the Makefile's PROMETHEUS_IMAGE (used by make check-rules).
PROMETHEUS_VERSION=v3.15.0
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_RETENTION=2d
PROMETHEUS_MEM_LIMIT=256m
# alertmanager-mcp reads alert history (ALERTS series) from here; empty = Alertmanager only
ALERTS_PROMETHEUS_URL=http://aiops-prometheus:9090
# Grafana (optional UI: make ui-up / make grafana-up). Anonymous read-only viewers, local only.
GRAFANA_VERSION=13.2.2
GRAFANA_PORT=3000
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=aiops-local-only
# prometheus-mcp (PR-021, in docker-compose.mcp.yml): the `metrics` capability, and its
# server-side guardrails. METRICS_ALLOWLIST = comma-separated metric-name regexes (empty = all).
METRICS_MCP_PORT=8103
METRICS_MCP_URL=http://localhost:8103/mcp
METRICS_PROM_URL=http://aiops-prometheus:9090
# Prometheus-compatible backends (Thanos, Mimir, Grafana Cloud, VictoriaMetrics): point
# METRICS_PROM_URL at the query API (Grafana Cloud/Mimir: the .../prometheus path) and set
# a bearer token OR basic auth; METRICS_PROM_ORG_ID -> X-Scope-OrgID (multi-tenant Mimir).
METRICS_PROM_BEARER_TOKEN=
METRICS_PROM_USERNAME=
METRICS_PROM_PASSWORD=
METRICS_PROM_ORG_ID=
METRICS_QUERY_TIMEOUT_S=20
METRICS_MAX_RANGE_HOURS=24
METRICS_MAX_POINTS=1100
METRICS_MIN_STEP_S=15
METRICS_MAX_SERIES=50
METRICS_ALLOWLIST=http_.*,db_pool_.*,redis_up,process_.*,kube_.*,up,ALERTS.*

# --- Second logs backend: Loki (PR-P4a) — docs/setup/loki.md ---------------------
# Opt-in (make loki-up): Loki single binary + loki-mcp; Fluent Bit ships prod logs to both
# Elasticsearch and Loki. Profile local-loki selects it (capabilities.logs.provider: loki).
LOKI_VERSION=3.7.8
LOKI_PORT=3101
LOKI_MEM_LIMIT=256m
LOKI_GOMEMLIMIT=180MiB
LOKI_MCP_PORT=8110
LOKI_MCP_URL=http://localhost:8110/mcp
LOKI_URL=http://aiops-loki:3100
# Grafana Cloud Logs / multi-tenant Loki: bearer token OR basic auth; LOKI_ORG_ID -> X-Scope-OrgID.
LOKI_BEARER_TOKEN=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_ORG_ID=
# Server-side guardrails: every stream selector must contain one of these exact matchers.
LOKI_ALLOWED_STREAMS=namespace=prod
LOKI_QUERY_TIMEOUT_S=30
LOKI_MAX_RANGE_HOURS=48
LOKI_MAX_LINES=500
LOKI_MAX_SERIES=1000

# --- Evidence store (PR-032) ---------------------------------------------------
# Investigations, events, approvals and audit in Postgres schema `investigations`
# (`aiops db upgrade`, `aiops history`, `aiops show <id>`). Empty = POSTGRES_* above.
AIOPS_DATABASE_URL=

# --- REST + SSE API (PR-035): `make api` / `make api-up`, docs/api/README.md --------------
# Browser origins allowed by CORS (the Web UI), comma-separated.
AIOPS_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Optional shared secret: every /api route except /api/health then needs `X-API-Key`.
# Off (empty) locally. SECRET: never commit a value.
AIOPS_API_KEY=
# Optional NAMED keys (PR-042) "name:KEY,name2:KEY2" (keys 16+ chars): each key is an identity,
# and with auth on only a named key may approve/deny (recorded as that name). SECRET.
AIOPS_API_KEYS=
# The Web UI's server-side proxy adds this X-API-Key (never sent to the browser). Use a
# named key's value. `make demo-live` generates one per run.
AIOPS_UI_API_KEY=
# Web UI replays (make demo): seconds each recorded tool call waits, so a replayed
# investigation unfolds at a watchable pace in the live view. 0 = instant.
AIOPS_REPLAY_TOOL_DELAY_S=0.5
# 1 = enable POST /api/scenarios/{id}/inject|revert (live fault injection into the local
# Minikube, one scenario at a time via .data/cluster.lock). Anything else = 403.
# Double-guarded (PR-042): also needs API auth (AIOPS_API_KEY/AIOPS_API_KEYS + X-API-Key).
AIOPS_ENABLE_FAULTS=0
# Settings -> Integrations (PR-046): secrets typed in the Web UI (e.g. an MCP server's
# Authorization header) are stored in Postgres encrypted with this Fernet key. Empty = the UI
# refuses to save secrets (non-secret settings still work). SECRET: never commit a value.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating/losing it makes saved secrets unusable (the UI says so; type them again).
AIOPS_SECRETS_KEY=
# kubectl context used by the fault endpoints.
# AIOPS_FAULTS_KUBE_CONTEXT=aiops
API_PORT=8000

# --- AI observability + cost controls (PR-041): docs/observability.md -------------------
# Prometheus metrics are always on the API's /metrics (no key needed; never proxied by the
# Web UI). Cost estimates use the profile's `cost.pricing` table (Groq free tier = $0).
# OpenTelemetry traces: OFF unless an OTLP/HTTP endpoint is set. Opt-in local backend:
# `make tracing-up` (Jaeger, UI http://localhost:16686), then for `make api` / the CLI:
AIOPS_OTLP_ENDPOINT=
# ...and for the api CONTAINER (make demo / api-up), the in-network address:
# AIOPS_OTLP_ENDPOINT_IN_NETWORK=http://aiops-jaeger:4318
AIOPS_OTLP_ENDPOINT_IN_NETWORK=
# The standard OTEL_EXPORTER_OTLP_ENDPOINT is honoured too when AIOPS_OTLP_ENDPOINT is empty.
JAEGER_VERSION=2.21.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
JAEGER_MEM_LIMIT=128m

# --- Knowledge base (PR-028) ---------------------------------------------------
# Runbooks in knowledge-base/ -> Postgres full-text search (schema `knowledge`, no models).
# `make ingest-knowledge` writes it (POSTGRES_* above, or this URL); knowledge-mcp only reads it.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_SCHEMA=knowledge
KNOWLEDGE_MCP_PORT=8108
KNOWLEDGE_MCP_URL=http://localhost:8108/mcp
KNOWLEDGE_MAX_K=10
KNOWLEDGE_STATEMENT_TIMEOUT_MS=5000

# --- Tickets / Jira (PR-012) — docs/setup/jira.md ----------------------------
# Provider for the `tickets` capability: mock (default, offline) | jira (Jira Cloud)
TICKETS_PROVIDER=mock
# mock-tickets-mcp: http://localhost:8109/mcp · mcp-atlassian (jira): http://localhost:8102/mcp
TICKETS_MCP_URL=http://localhost:8109/mcp
TICKETS_PROJECT_KEY=OPS
# Base URL for ticket links ({base}/browse/OPS-12): mock page, or https://<site>.atlassian.net
TICKETS_UI_URL=http://localhost:8109
# Server-side guardrails for both servers: visible projects, and whether writes exist at all
TICKETS_ALLOWED_PROJECTS=OPS
TICKETS_READ_ONLY_MODE=false
MOCK_TICKETS_MCP_PORT=8109
# Real Jira Cloud (free site) through sooperset/mcp-atlassian, pinned version
JIRA_MCP_PORT=8102
MCP_ATLASSIAN_VERSION=0.23.1
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Replays (make demo) reason with the configured LLM instead of the scripted one: real | (empty)
AIOPS_REPLAY_LLM=
