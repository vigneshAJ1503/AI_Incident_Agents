# Copy to .env and fill in. NEVER commit .env.
# Variables are added PR by PR; each is documented where it is introduced.

# --- Environment selection -------------------------------------------------
# Which config/environments/<name>.yaml to load (PR-002)
AIOPS_ENV=local

# --- LLM provider (PR-004) — zero cost: docs/setup/zero-cost.md -------------
# openai_compat works with hosted Groq (free) or Gemini (free). No local models.
LLM_PROVIDER=openai_compat
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
# Model per role; pick from your provider's model list (must support tool calling)
LLM_MODEL_FAST=
LLM_MODEL_AGENT=
LLM_MODEL_RCA=

# --- Local infrastructure (PR-007) -------------------------------------------
# Pinned image versions (never :latest)
ES_VERSION=8.19.4
KIBANA_VERSION=8.19.4
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7.4-alpine
# Host ports (bound to 127.0.0.1). Postgres/Redis use non-default ports to avoid clashing
# with locally installed services.
ES_PORT=9200
KIBANA_PORT=5601
POSTGRES_PORT=15432
REDIS_PORT=16379
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops-local-only
POSTGRES_DB=aiops
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601

# --- MCP servers (PR-008) ----------------------------------------------------
LOGS_MCP_PORT=8101
LOGS_MCP_URL=http://localhost:8101/mcp
# Server-side guardrails for elasticsearch-mcp
LOGS_ALLOWED_INDEX_PATTERNS=payment-prod-*,order-prod-*,user-prod-*,inventory-prod-*,payment-staging-*,order-staging-*,user-staging-*,inventory-staging-*,logs-k8s-*
LOGS_MAX_TIME_RANGE_HOURS=48
LOGS_MAX_RESULTS=1000
LOGS_QUERY_TIMEOUT_S=30

# --- Code agent / git-mcp (PR-026, PR-027) -------------------------------------
# git-mcp serves .data/sample-repo (make seed-repo S=S1), mounted read-only
CODE_MCP_PORT=8107
CODE_MCP_URL=http://localhost:8107/mcp
# CODE_SAMPLE_REPO_DIR=../../.data/sample-repo   # relative to deploy/compose/
# Server-side guardrails for git-mcp
CODE_MAX_COMMITS=200
CODE_MAX_DIFF_CHARS=40000
CODE_MAX_RANGE_DAYS=90
# Optional commit deep link for evidence, e.g. https://github.com/acme/{repo}/commit/{sha}
CODE_UI_LINK_TEMPLATE=

# --- Alerts (PR-023) -----------------------------------------------------------
# Alertmanager (in docker-compose.infra.yml). Alerts are seeded with `make seed-alerts S=S1`
# until Prometheus evaluates the rules (PR-020). Keep the version in sync with the Makefile.
ALERTMANAGER_VERSION=v0.34.1
ALERTMANAGER_PORT=9093
ALERTMANAGER_URL=http://localhost:9093
# alertmanager-mcp (PR-024, in docker-compose.mcp.yml) and its server-side guardrails
ALERTS_MCP_PORT=8105
ALERTS_MCP_URL=http://localhost:8105/mcp
ALERTS_MAX_RESULTS=200
ALERTS_MAX_TIME_RANGE_HOURS=168
ALERTS_QUERY_TIMEOUT_S=15

# --- Knowledge base (PR-028) ---------------------------------------------------
# Runbooks in knowledge-base/ -> Postgres full-text search (schema `knowledge`, no models).
# `make ingest-knowledge` writes it (POSTGRES_* above, or this URL); knowledge-mcp only reads it.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_SCHEMA=knowledge
KNOWLEDGE_MCP_PORT=8108
KNOWLEDGE_MCP_URL=http://localhost:8108/mcp
KNOWLEDGE_MAX_K=10
KNOWLEDGE_STATEMENT_TIMEOUT_MS=5000

# --- Tickets / Jira (PR-012) — docs/setup/jira.md ----------------------------
# Provider for the `tickets` capability: mock (default, offline) | jira (Jira Cloud)
TICKETS_PROVIDER=mock
# mock-tickets-mcp: http://localhost:8109/mcp · mcp-atlassian (jira): http://localhost:8102/mcp
TICKETS_MCP_URL=http://localhost:8109/mcp
TICKETS_PROJECT_KEY=OPS
# Base URL for ticket links ({base}/browse/OPS-12): mock page, or https://<site>.atlassian.net
TICKETS_UI_URL=http://localhost:8109
# Server-side guardrails for both servers: visible projects, and whether writes exist at all
TICKETS_ALLOWED_PROJECTS=OPS
TICKETS_READ_ONLY_MODE=false
MOCK_TICKETS_MCP_PORT=8109
# Real Jira Cloud (free site) through sooperset/mcp-atlassian, pinned version
JIRA_MCP_PORT=8102
MCP_ATLASSIAN_VERSION=0.23.1
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
