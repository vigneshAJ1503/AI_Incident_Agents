{
  "$defs": {
    "AgentStatus": {
      "enum": [
        "success",
        "no_signal",
        "partial",
        "failed"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "ClaimKind": {
      "enum": [
        "FACT",
        "OBSERVATION",
        "CORRELATION",
        "HYPOTHESIS",
        "RECOMMENDATION"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "kind",
        "source",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "log",
        "metric",
        "alert",
        "k8s_event",
        "commit",
        "ticket",
        "doc"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "type",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "duration_ms": {
          "default": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "result_chars": {
          "default": 0,
          "title": "Result Chars",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error",
            "blocked",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "capability",
        "tool"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "agent_version": {
      "default": "0",
      "title": "Agent Version",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "duration_ms": {
      "default": 0.0,
      "title": "Duration Ms",
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "signals": {
      "items": {
        "type": "string"
      },
      "title": "Signals",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/AgentStatus"
    },
    "suggested_followups": {
      "items": {
        "type": "string"
      },
      "title": "Suggested Followups",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    }
  },
  "required": [
    "agent",
    "task_id",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
