# Web UI (frontend/). Copy to frontend/.env.local; NEXT_PUBLIC_* values are baked in at build time.

# Backend API base URL (docs/api/contract.md). Used when demo mode is off.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# 1 = serve the static demo dataset (src/demo/*.json) and simulate live SSE; no backend needed.
NEXT_PUBLIC_DEMO=0

# Demo only: replay speed-up for simulated live investigations (1 = recorded timing).
NEXT_PUBLIC_DEMO_SPEED=4
