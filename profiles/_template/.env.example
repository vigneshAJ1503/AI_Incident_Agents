# Every ${VAR} used by this profile. Copy to .env in this folder (gitignored) and fill in:
#   cp profiles/<company>/.env.example profiles/<company>/.env
# Precedence: the shell > profiles/<company>/.env > the repo .env.
# SECRETS: never commit them; prefer your secret manager to inject them as env vars.
# READ-ONLY credentials only (docs/portability.md, "Read-only credentials checklist").

# --- LLM (required) -------------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1   # or Groq/Gemini/Azure/LiteLLM gateway
OPENAI_COMPAT_API_KEY=                             # SECRET
LLM_MODEL_AGENT=                                   # a model with tool calling
# LLM_MODEL_FAST=                                  # optional
# LLM_MODEL_RCA=                                   # optional

# --- MCP servers: one per capability (required for the capabilities you keep) ----------
LOGS_MCP_URL=http://localhost:8101/mcp
METRICS_MCP_URL=http://localhost:8103/mcp
ALERTS_MCP_URL=http://localhost:8105/mcp
K8S_MCP_URL=http://localhost:8106/mcp
CODE_MCP_URL=http://localhost:8107/mcp
TICKETS_MCP_URL=http://localhost:8102/mcp
KNOWLEDGE_MCP_URL=http://localhost:8108/mcp

# --- Tickets (Jira) -------------------------------------------------------------------
TICKETS_PROJECT_KEY=OPS
JIRA_URL=https://your-site.atlassian.net
# mcp-atlassian itself needs JIRA_USERNAME and JIRA_API_TOKEN (SECRET, read-only user);
# they are passed to that server, not to this profile.

# --- Deep links (the UIs your engineers already use) -----------------------------------
KIBANA_URL=https://kibana.example.com
GRAFANA_URL=https://grafana.example.com
PROMETHEUS_URL=https://prometheus.example.com
ALERTMANAGER_URL=https://alertmanager.example.com
# K8S_UI_LINK_TEMPLATE=https://console.example.com/k8s/{namespace}/{kind}/{name}
# CODE_UI_LINK_TEMPLATE=https://github.com/your-org/{repo}/commit/{sha}
