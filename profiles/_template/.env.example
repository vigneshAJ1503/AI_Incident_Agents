# Every ${VAR} used by this profile. Copy to .env in this folder (gitignored) and fill in:
#   cp profiles/<company>/.env.example profiles/<company>/.env
# Precedence: the shell > profiles/<company>/.env > the repo .env.
# SECRETS: never commit them; prefer your secret manager to inject them as env vars.
# READ-ONLY credentials only (docs/portability.md, "Read-only credentials checklist").

# --- LLM (required): the variables of the llm block you kept in profile.yaml ----------
# docs/setup/llm-providers.md. Model ids per role (must support tool calling):
LLM_MODEL_AGENT=                                   # a model (Azure: deployment) name
# LLM_MODEL_FAST=                                  # optional
# LLM_MODEL_RCA=                                   # optional
# provider: openai_compat
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1   # or Groq/Gemini/OpenRouter/vLLM server
OPENAI_COMPAT_API_KEY=                             # SECRET
# provider: anthropic
# ANTHROPIC_API_KEY=                               # SECRET
# ANTHROPIC_BASE_URL=                              # optional gateway
# provider: bedrock (no key: AWS_PROFILE / SSO / IRSA / instance role)
# AWS_REGION=
# AWS_PROFILE=
# BEDROCK_ENDPOINT_URL=                            # optional VPC endpoint
# provider: azure_openai
# AZURE_OPENAI_ENDPOINT=                           # https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=                            # SECRET
# AZURE_OPENAI_API_VERSION=

# --- MCP servers: one per capability (required for the capabilities you keep) ----------
LOGS_MCP_URL=http://localhost:8101/mcp
METRICS_MCP_URL=http://localhost:8103/mcp
ALERTS_MCP_URL=http://localhost:8105/mcp
K8S_MCP_URL=http://localhost:8106/mcp
CODE_MCP_URL=http://localhost:8107/mcp
TICKETS_MCP_URL=http://localhost:8102/mcp
KNOWLEDGE_MCP_URL=http://localhost:8108/mcp

# --- Metrics backend (read by prometheus-mcp, not by this profile) ---------------------
# Any Prometheus-compatible query API: Prometheus, Thanos, Mimir, Grafana Cloud (the
# .../prometheus URL), VictoriaMetrics. Bearer token OR basic auth (SECRET, read-only).
# METRICS_PROM_URL=https://prometheus.example.com
# METRICS_PROM_BEARER_TOKEN=
# METRICS_PROM_USERNAME=
# METRICS_PROM_PASSWORD=
# METRICS_PROM_ORG_ID=          # X-Scope-OrgID for multi-tenant Mimir/Cortex

# --- Tickets (Jira) -------------------------------------------------------------------
TICKETS_PROJECT_KEY=OPS
JIRA_URL=https://your-site.atlassian.net
# mcp-atlassian itself needs JIRA_USERNAME and JIRA_API_TOKEN (SECRET, read-only user);
# they are passed to that server, not to this profile.

# --- Deep links (the UIs your engineers already use) -----------------------------------
KIBANA_URL=https://kibana.example.com
GRAFANA_URL=https://grafana.example.com
PROMETHEUS_URL=https://prometheus.example.com
ALERTMANAGER_URL=https://alertmanager.example.com
# K8S_UI_LINK_TEMPLATE=https://console.example.com/k8s/{namespace}/{kind}/{name}
# CODE_UI_LINK_TEMPLATE=https://github.com/your-org/{repo}/commit/{sha}

# --- aiops catalog import --from backstage --url ... (read-only API token; optional) ---
# BACKSTAGE_TOKEN=

# --- REST + SSE API (PR-035, `aiops serve`) ------------------------------------------
# AIOPS_API_CORS_ORIGINS=http://localhost:3000   # comma-separated browser origins
# AIOPS_API_KEY=                                 # optional: require X-API-Key (SECRET)
# AIOPS_API_KEYS=alice:KEY,bob:KEY               # optional: named keys = approver identities (SECRET)

# --- AI observability (PR-041, docs/observability.md) ------------------------------------
# AIOPS_OTLP_ENDPOINT=http://otel-collector:4318  # optional: export OpenTelemetry traces (OTLP/HTTP)
