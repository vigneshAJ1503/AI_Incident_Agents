# profiles/local-loki extends profiles/local-k8s (-> profiles/local): see
# profiles/local/.env.example for the shared variables. Needs `make k8s-up logging-up loki-up`
# (docs/setup/loki.md).

# loki-mcp endpoint (make loki-up publishes it on 127.0.0.1:8110).
LOKI_MCP_URL=http://localhost:8110/mcp
# Where Grafana Explore deep links point (make grafana-up).
GRAFANA_URL=http://localhost:3000
