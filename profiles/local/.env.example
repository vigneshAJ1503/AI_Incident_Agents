# Variables referenced by profiles/local/profile.yaml (${VAR} / ${VAR:-default}).
# All are OPTIONAL here: the local demo has working defaults. The repo-root .env.example
# lists the same names plus the docker-compose stack's variables (ports, image versions).
# Put values in the repo .env or in profiles/local/.env (both gitignored); the shell wins.

# --- LLM (hosted free tiers only; no local models) -----------------------------------
LLM_PROVIDER=openai_compat              # openai_compat | fake
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=                  # SECRET
LLM_MODEL_FAST=
LLM_MODEL_AGENT=
LLM_MODEL_RCA=

# --- MCP servers (docker-compose.mcp.yml) --------------------------------------------
LOGS_MCP_URL=http://localhost:8101/mcp
METRICS_MCP_URL=http://localhost:8103/mcp
ALERTS_MCP_URL=http://localhost:8105/mcp
K8S_MCP_URL=http://localhost:8106/mcp
CODE_MCP_URL=http://localhost:8107/mcp
KNOWLEDGE_MCP_URL=http://localhost:8108/mcp
TICKETS_MCP_URL=http://localhost:8109/mcp

# --- Tickets: mock (offline) or a free Jira Cloud site (docs/setup/jira.md) -----------
TICKETS_PROVIDER=mock                   # mock | jira
TICKETS_PROJECT_KEY=OPS
TICKETS_UI_URL=http://localhost:8109

# --- Deep links in evidence (UIs are optional) ---------------------------------------
KIBANA_URL=http://localhost:5601
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
K8S_UI_LINK_TEMPLATE=
CODE_UI_LINK_TEMPLATE=
